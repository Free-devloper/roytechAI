{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/api/assistant/chat", "destination": "/api/assistant" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/((?!api/|assets/|robots.txt|sitemap.xml).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/assistant.js": {
      "includeFiles": "data/chunks.json",
      "maxDuration": 60
    },
    "api/contact.js": {
      "maxDuration": 15
    }
  }
}
